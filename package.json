    "deploy": "clasp version && clasp deploy",
    "open": "clasp open"
  },
  "devDependencies": {
    "@google/clasp": "^3.0.0",
    "@types/google-apps-script": "^1.0.0",
    "typescript": "^5.0.0"
  }
}
