{
  "name": "drive-scribe",
  "version": "0.1.0",
  "private": true,
  "description": "Recursive Google Drive hierarchy walker: Docs to Markdown, Sheets to JSON, tabs included. Published as an Apps Script library.",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc --noEmit",
